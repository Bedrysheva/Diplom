					Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Выборка.ДатаОкончания, -1));  
					//календарные дни отпуска
					Движение.КоличествоДней = (Выборка.ДатаОкончания - Выборка.ДатаНачала)/86400; //86400 - колво секунд в одном днне
				КонецЕсли;	
		КонецЕсли;	
	

	// регистр ВКМ_ДополнительныеНачисления
		Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
		Если ТипЗнч(Выборка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ДополнительныеНачисления") Тогда				
			Движение = Движения.ВКМ_ДополнительныеНачисления.Добавить();
			Движение.Сторно = Ложь;
			Движение.ВидРасчета = Выборка.ВидРасчета;
			Движение.ПериодРегистрации = Дата;
			Движение.Сотрудник = Выборка.Сотрудник;
			
			Если Выборка.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ПроцентОтРабот Тогда 
				Движение.Размер = Выборка.СуммаКонтрагенту*Выборка.ПроцентОтРабот/100;
			Иначе	
				Движение.Размер = Выборка.Размер; 
			КонецЕсли;					
		КонецЕсли;		
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	Движения.ВКМ_ДополнительныеНачисления.Записать();
	

КонецПроцедуры

Процедура СформироватьДвиженияУдержаний() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_ОсновныеНачисления.НомерСтроки КАК НомерСтроки,
	               |	ВКМ_ОсновныеНачисления.Результат КАК Результат,
	               |	ВКМ_ОсновныеНачисления.ВидРасчета КАК ВидРасчета,
	               |	ВКМ_ОсновныеНачисления.Сотрудник КАК Сотрудник
	               |ИЗ
	               |	РегистрРасчета.ВКМ_ОсновныеНачисления КАК ВКМ_ОсновныеНачисления
	               |ГДЕ
	               |	ВКМ_ОсновныеНачисления.Регистратор = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВКМ_ДополнительныеНачисления.НомерСтроки,
	               |	ВКМ_ДополнительныеНачисления.Результат,
	               |	ВКМ_ДополнительныеНачисления.ВидРасчета,
	               |	ВКМ_ДополнительныеНачисления.Сотрудник
	               |ИЗ
	               |	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
	               |ГДЕ
	               |	ВКМ_ДополнительныеНачисления.Регистратор = &Ссылка"; 
	
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Движения.ВКМ_Удержания.Записывать = Истина;
		
		ПроцентНДФЛ = 13;
		Движение = Движения.ВКМ_Удержания.Добавить();
		Движение.Сторно = Ложь;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Движение.ВидРасчетаБаза = Выборка.ВидРасчета; 
		Движение.ПериодРегистрации = Дата;
		Движение.Сотрудник = Выборка.Сотрудник;  		
		Движение.Размер = Выборка.Результат;
		Движение.Результат = Движение.Размер*ПроцентНДФЛ/100;   
		
	КонецЦикла;	
	Движения.ВКМ_Удержания.Записать();
КонецПроцедуры	

Процедура ПроведениеПоРегиструВзаиморасчетыССотрудниками()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_ОсновныеНачисления.Сотрудник КАК Сотрудник,
	               |	ВКМ_ОсновныеНачисления.Результат КАК Начислено
	               |ПОМЕСТИТЬ ВТ_Начисления
	               |ИЗ
	               |	РегистрРасчета.ВКМ_ОсновныеНачисления КАК ВКМ_ОсновныеНачисления
	               |ГДЕ
	               |	ВКМ_ОсновныеНачисления.Регистратор = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВКМ_ДополнительныеНачисления.Сотрудник,
	               |	ВКМ_ДополнительныеНачисления.Результат
	               |ИЗ
	               |	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
	               |ГДЕ
	               |	ВКМ_ДополнительныеНачисления.Регистратор = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВКМ_Удержания.Результат) КАК Удержания,
	               |	ВКМ_Удержания.Сотрудник КАК Сотрудник
	               |ПОМЕСТИТЬ ВТ_Удержено
	               |ИЗ
	               |	РегистрРасчета.ВКМ_Удержания КАК ВКМ_Удержания
	               |ГДЕ
	               |	ВКМ_Удержания.Регистратор = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВКМ_Удержания.Сотрудник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Начисления.Сотрудник КАК Сотрудник,
	               |	СУММА(ВТ_Начисления.Начислено) КАК Начислено
	               |ПОМЕСТИТЬ ВТ_ВсегоНачислено
	               |ИЗ
	               |	ВТ_Начисления КАК ВТ_Начисления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Начисления.Сотрудник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Удержено.Удержания КАК Удержания,
	               |	ВТ_ВсегоНачислено.Начислено КАК Начислено,
	               |	ВТ_ВсегоНачислено.Сотрудник КАК Сотрудник
	               |ИЗ
	               |	ВТ_ВсегоНачислено КАК ВТ_ВсегоНачислено
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Удержено КАК ВТ_Удержено
	               |		ПО ВТ_ВсегоНачислено.Сотрудник = ВТ_Удержено.Сотрудник";
	
	
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	Пока  Выборка.Следующий() Цикл 
		 Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.ДобавитьПриход();
		 Движение.Период = Дата;
		 Движение.Сотрудник = Выборка.Сотрудник;
		 Движение.Сумма = Выборка.Начислено - Выборка.Удержания;  
	 КонецЦикла;	
	
 КонецПроцедуры	
 
Процедура ВыполнитьАвтозаполнение(ДатаДокумента)  Экспорт
	 Начисления.Очистить();
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ВКМ_ФизическиеЛица.Ссылка КАК Ссылка,
	                |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.Должность КАК Должность,
	                |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.Оклад КАК Оклад,
	                |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.ПроцентОтРабот КАК ПроцентОтРабот,
	                |	ЕСТЬNULL(ВКМ_ВыполненныеСотрудникомРаботыОбороты.ЧасовКОплатеОборот, 0) КАК ЧасыКОплате
	                |ПОМЕСТИТЬ ВТ_ДолжностиСотрудников
	                |ИЗ
	                |	Справочник.ВКМ_ФизическиеЛица КАК ВКМ_ФизическиеЛица
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&НачалоПериода, ) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
	                |		ПО (ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник = ВКМ_ФизическиеЛица.Ссылка)
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ВКМ_ВыполненныеСотрудникомРаботыОбороты
	                |		ПО ВКМ_ФизическиеЛица.Ссылка = ВКМ_ВыполненныеСотрудникомРаботыОбороты.Сотрудник
	                |ГДЕ
	                |	НЕ ВКМ_ФизическиеЛица.ПометкаУдаления
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ВТ_ДолжностиСотрудников.Ссылка КАК Сотрудник,
	                |	ВТ_ДолжностиСотрудников.Оклад КАК Оклад,
	                |	ВТ_ДолжностиСотрудников.ПроцентОтРабот КАК ПроцентОтРабот,
	                |	ВКМ_ДолжностиЕжемесячныеНачисления.Начисление КАК Начисление,
	                |	ВКМ_ДолжностиЕжемесячныеНачисления.Ссылка.ГрафикРаботы КАК ГрафикРаботы,
	                |	ВТ_ДолжностиСотрудников.ЧасыКОплате КАК ЧасыКОплате
	                |ИЗ
	                |	ВТ_ДолжностиСотрудников КАК ВТ_ДолжностиСотрудников
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВКМ_Должности.ЕжемесячныеНачисления КАК ВКМ_ДолжностиЕжемесячныеНачисления
	                |		ПО ВТ_ДолжностиСотрудников.Должность = ВКМ_ДолжностиЕжемесячныеНачисления.Ссылка";
	 
	 Запрос.Параметры.Вставить("НачалоПериода", НачалоМесяца(ДатаДокумента)); 
	 Запрос.Параметры.Вставить("КонецПериода", КонецМесяца(ДатаДокумента));
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Пока Выборка.Следующий() Цикл
		 
		 Если Выборка.Начисление = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ПроцентОтРабот 
			 И Выборка.ЧасыКОплате = 0 Тогда 
			 Продолжить;
		 КонецЕсли;	
		 
		 НоваяСтрока = Начисления.Добавить();
		 НоваяСтрока.Сотрудник = Выборка.Сотрудник; 		 
		 НоваяСтрока.График = Выборка.ГрафикРаботы;
		 НоваяСтрока.ВидРасчета = Выборка.Начисление;
		 НоваяСтрока.ДатаНачала = НачалоМесяца(Дата);
		 НоваяСтрока.ДатаОкончания = КонецМесяца(Дата);
	 КонецЦикла;	
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
		 |	ВКМ_ГрафикОтпусковОтпускаСотрудников.Сотрудник КАК Сотрудник,
		 |	ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаНачала КАК ДатаНачала,
		 |	ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаОкончания КАК ДатаОкончания,
		 |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.Должность.ГрафикРаботы КАК ГрафикРаботы
		 |ИЗ
		 |	Документ.ВКМ_ГрафикОтпусков.ОтпускаСотрудников КАК ВКМ_ГрафикОтпусковОтпускаСотрудников
		 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&ДатаДокумента, ) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
		 |		ПО ВКМ_ГрафикОтпусковОтпускаСотрудников.Сотрудник = ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник
		 |ГДЕ
		 |	НАЧАЛОПЕРИОДА(ВКМ_ГрафикОтпусковОтпускаСотрудников.Ссылка.Год, ГОД) = НАЧАЛОПЕРИОДА(&ДатаДокумента, ГОД)
		 |	И (МЕСЯЦ(ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаНачала) = МЕСЯЦ(&ДатаДокумента)
		 |			ИЛИ МЕСЯЦ(ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаОкончания) = МЕСЯЦ(&ДатаДокумента)
		 |			ИЛИ ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаНачала < НАЧАЛОПЕРИОДА(&ДатаДокумента, МЕСЯЦ)
		 |				И ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаОкончания > КОНЕЦПЕРИОДА(&ДатаДокумента, МЕСЯЦ))";
		 
	 
	 Запрос.Параметры.Вставить("ДатаДокумента", ДатаДокумента);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
		 НоваяСтрока = Начисления.Добавить();
		 НоваяСтрока.Сотрудник = Выборка.Сотрудник;
		 НоваяСтрока.График = Выборка.ГрафикРаботы;
		 НоваяСтрока.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск;
		 
		 НоваяСтрока.ДатаНачала = Макс(НачалоМесяца(Дата), Выборка.ДатаНачала);
		 НоваяСтрока.ДатаОкончания = Мин(КонецМесяца(Дата), Выборка.ДатаОкончания);
	 КонецЦикла;
	 
	 Начисления.Сортировать("Сотрудник");
 КонецПроцедуры	 
#КонецОбласти
	


#КонецЕсли
